---
import { nav, legalNav, ui } from '../i18n/ui'
import { localePath, type Lang } from '../i18n/utils'
import { business } from '../data/business'

interface Props { lang: Lang }
const { lang } = Astro.props

const brandLinks = nav.filter((n) => ['/notre-histoire', '/menu', '/nos-adresses', '/carrieres'].includes(n.path))
const orderLinks = [
  { path: '/commander', label: { fr: 'Click & collect', en: 'Click & collect' } },
  { path: '/fidelite', label: { fr: 'Fidélité', en: 'Loyalty' } },
]
const companyLinks = nav.filter((n) => ['/entreprises', '/contact', '/faq'].includes(n.path))
---

<footer class="mt-16 bg-ink text-[#d8cfc4]">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 md:grid-cols-4">
    <div>
      <p class="font-serif text-2xl font-bold text-white">Clau<span class="text-accent">bert</span></p>
      <p class="mt-2 text-sm">{business.tagline[lang]}.</p>
      <p class="mt-2 text-sm font-semibold text-white">{ui.hours[lang]}</p>
      <p class="mt-1 text-sm">{business.street}, {business.postalCode} {business.city}</p>
      <div class="mt-3 flex gap-3 text-sm">
        <a href={business.social.tiktok} class="hover:text-white">TikTok</a>
        <a href={business.social.instagram} class="hover:text-white">Instagram</a>
        <a href={business.social.linkedin} class="hover:text-white">LinkedIn</a>
        <a href={business.social.facebook} class="hover:text-white">Facebook</a>
      </div>
    </div>

    <div>
      <h4 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">{ui.footerBrand[lang]}</h4>
      <ul class="space-y-2 text-sm">
        {brandLinks.map((l) => (<li><a href={localePath(l.path, lang)} class="hover:text-white">{l.label[lang]}</a></li>))}
      </ul>
    </div>

    <div>
      <h4 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">{ui.footerOrder[lang]}</h4>
      <ul class="space-y-2 text-sm">
        {orderLinks.map((l) => (<li><a href={localePath(l.path, lang)} class="hover:text-white">{l.label[lang]}</a></li>))}
      </ul>
      <h4 class="mb-3 mt-6 text-sm font-semibold uppercase tracking-wide text-white">{ui.footerCompanies[lang]}</h4>
      <ul class="space-y-2 text-sm">
        {companyLinks.map((l) => (<li><a href={localePath(l.path, lang)} class="hover:text-white">{l.label[lang]}</a></li>))}
      </ul>
    </div>

    <div>
      <h4 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">{ui.footerLegal[lang]}</h4>
      <ul class="space-y-2 text-sm">
        {legalNav.map((l) => (<li><a href={localePath(l.path, lang)} class="hover:text-white">{l.label[lang]}</a></li>))}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-center text-xs text-[#8c8178]">
    © 2026 Claubert — {lang === 'fr' ? 'Maquette de travail.' : 'Work in progress.'}
  </div>
</footer>
