---
import { nav, ui } from '../i18n/ui'
import { localePath, logicalPath, type Lang } from '../i18n/utils'

interface Props { lang: Lang }
const { lang } = Astro.props
const logical = logicalPath(Astro.url)
const otherLang: Lang = lang === 'fr' ? 'en' : 'fr'
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={localePath('/', lang)} class="font-serif text-2xl font-bold tracking-tight">
      Clau<span class="text-accent">bert</span>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium md:flex">
      {nav.map((item) => (
        <a href={localePath(item.path, lang)} class="hover:text-accent">{item.label[lang]}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={localePath(logical, otherLang)}
        class="rounded-full border border-line px-2.5 py-1 text-xs font-semibold text-ink-soft hover:text-ink"
        aria-label={lang === 'fr' ? 'Switch to English' : 'Passer en français'}
      >
        {lang === 'fr' ? 'FR · EN' : 'EN · FR'}
      </a>
      <a
        href={localePath('/commander', lang)}
        class="hidden rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-dark sm:inline-block"
      >
        {ui.order[lang]}
      </a>

      <!-- Menu mobile -->
      <details class="relative md:hidden">
        <summary class="flex size-9 cursor-pointer list-none items-center justify-center rounded-lg border border-line text-xl">☰</summary>
        <div class="absolute right-0 mt-2 flex w-52 flex-col gap-1 rounded-xl border border-line bg-surface p-2 shadow-lg">
          {nav.map((item) => (
            <a href={localePath(item.path, lang)} class="rounded-lg px-3 py-2 text-sm hover:bg-bg">{item.label[lang]}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
