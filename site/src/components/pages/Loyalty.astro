---
import BaseLayout from '../../layouts/BaseLayout.astro'
import type { Lang } from '../../i18n/utils'
interface Props { lang: Lang }
const { lang } = Astro.props
const title = lang === 'fr' ? 'Programme fidélité — Claubert' : 'Loyalty program — Claubert'
const description = lang === 'fr'
  ? 'Le programme fidélité Claubert : 1€ dépensé = 1 point. Café, dessert, sandwich offert. Inscription en 30 secondes.'
  : 'The Claubert loyalty program: 1€ spent = 1 point. Free coffee, dessert, sandwich. Sign up in 30 seconds.'
const rewards = [
  { pts: 75, fr: 'Café offert', en: 'Free coffee', e: '☕' },
  { pts: 125, fr: 'Dessert offert', en: 'Free dessert', e: '🍰' },
  { pts: 200, fr: 'Sandwich Classique offert', en: 'Free Classic sandwich', e: '🥪' },
  { pts: 350, fr: 'Menu Signature offert', en: 'Free Signature menu', e: '🍽️' },
]
---
<BaseLayout title={title} description={description} lang={lang}>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <div class="rounded-3xl bg-gradient-to-br from-[#a8360f] to-[#6e2208] p-8 text-white">
      <h1 class="text-3xl font-semibold">{lang === 'fr' ? 'Programme fidélité' : 'Loyalty program'}</h1>
      <p class="mt-2 text-white/85">{lang === 'fr' ? '1 € dépensé = 1 point' : '1 € spent = 1 point'}</p>
    </div>
    <h2 class="mt-8 text-xl font-semibold">{lang === 'fr' ? 'Vos récompenses' : 'Your rewards'}</h2>
    <ul class="mt-3 space-y-2">
      {rewards.map((r) => (
        <li class="flex items-center gap-3 rounded-xl border border-line bg-surface p-3">
          <span class="grid size-10 place-items-center rounded-lg bg-bg text-xl">{r.e}</span>
          <span class="flex-1 font-medium">{lang === 'fr' ? r.fr : r.en}</span>
          <span class="text-sm font-semibold text-ink-soft">{r.pts} pts</span>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-ink-soft">{lang === 'fr'
      ? 'Inscrivez-vous en 30 secondes (email ou téléphone), cumulez des points à chaque commande et parrainez vos collègues.'
      : 'Sign up in 30 seconds (email or phone), earn points with every order and refer your colleagues.'}</p>
    <p class="mt-4 text-sm text-ink-soft">🔌 {lang === 'fr' ? 'Programme géré par Heypongo — à brancher.' : 'Program powered by Heypongo — to connect.'}</p>
  </section>
</BaseLayout>
