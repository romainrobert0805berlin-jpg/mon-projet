---
import BaseLayout from '../../layouts/BaseLayout.astro'
import type { Lang } from '../../i18n/utils'
interface Props { lang: Lang }
const { lang } = Astro.props
const title = lang === 'fr' ? 'Entreprises & plateaux repas — Claubert, La Défense' : 'Companies & catering — Claubert, La Défense'
const description = lang === 'fr'
  ? 'Plateaux repas entreprise à La Défense : livraison multi-étages, formules sur mesure. Devis sous 24h.'
  : 'Corporate catering at La Défense: multi-floor delivery, tailored offers. Quote within 24h.'
---
<BaseLayout title={title} description={description} lang={lang}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <div class="rounded-3xl bg-gradient-to-br from-slate-700 to-slate-900 p-8 text-white">
      <h1 class="text-3xl font-semibold">{lang === 'fr' ? 'Entreprises & plateaux repas' : 'Companies & catering'}</h1>
      <p class="mt-2 text-white/85">{lang === 'fr'
        ? 'Réunions, événements, déjeuners d’équipe : des formules sur mesure, livrées dans vos étages à La Défense. Lissez le pic du midi, régalez vos équipes.'
        : 'Meetings, events, team lunches: tailored offers delivered to your floors at La Défense. Smooth the lunch rush, delight your teams.'}</p>
    </div>

    <form class="mt-8 grid gap-4 sm:grid-cols-2" onsubmit="this.querySelector('[data-ok]').hidden=false;return false;">
      <label class="flex flex-col gap-1.5 text-sm font-medium">{lang === 'fr' ? 'Nombre de personnes' : 'Number of people'}
        <input type="number" min="1" required class="h-11 rounded-lg border border-line bg-surface px-3" /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">{lang === 'fr' ? 'Budget par personne' : 'Budget per person'}
        <input class="h-11 rounded-lg border border-line bg-surface px-3" placeholder="€" /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">{lang === 'fr' ? 'Date souhaitée' : 'Desired date'}
        <input type="date" class="h-11 rounded-lg border border-line bg-surface px-3" /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium">{lang === 'fr' ? 'Email' : 'Email'}
        <input type="email" required class="h-11 rounded-lg border border-line bg-surface px-3" /></label>
      <label class="flex flex-col gap-1.5 text-sm font-medium sm:col-span-2">{lang === 'fr' ? 'Message' : 'Message'}
        <textarea class="min-h-24 rounded-lg border border-line bg-surface px-3 py-2"></textarea></label>
      <button class="rounded-full bg-accent px-6 py-3 font-semibold text-white sm:col-span-2">{lang === 'fr' ? 'Demander un devis' : 'Request a quote'}</button>
      <p data-ok hidden class="rounded-lg bg-green/10 px-4 py-3 text-sm font-medium text-green sm:col-span-2">{lang === 'fr' ? 'Merci ! Nous revenons vers vous sous 24h.' : 'Thanks! We will get back to you within 24h.'}</p>
    </form>
    <p class="mt-4 text-sm text-ink-soft">🔌 {lang === 'fr' ? 'Catalogue PDF (formules, prix HT), facturation pro (virement, carte achat) — à fournir.' : 'PDF catalog (offers, pre-tax prices), business invoicing — to provide.'}</p>
  </section>
</BaseLayout>
